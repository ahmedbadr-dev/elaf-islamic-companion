rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Physical NFC UID → owner account
    match /nfcTags/{tagUid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.tagUid == tagUid
        && request.resource.data.keys().hasAll(['tagUid', 'userId', 'userEmail', 'isPro']);

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Per-user PRO + paired tag pointer
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Location pins for future «المساجد القريبة»
    // TEMP: public read for open dashboard (add login later)
    match /userLocations/{userId} {
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.purpose == 'nearby_mosques'
        && request.resource.data.keys().hasAll([
          'userId', 'latitude', 'longitude', 'cityLabel', 'purpose', 'updatedAt'
        ]);

      allow read: if true;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
